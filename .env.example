# ============================================================
# Landmark Online Chatbot — Required Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to git.
# ============================================================

# ---- Active Spring Profile (dev | prod) ----
SPRING_PROFILES_ACTIVE=dev

# ---- OpenAI ----
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- MySQL Database ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ChatBot
DB_USERNAME=chatuser
DB_PASSWORD=your_db_password_here

# ---- Redis ----
REDIS_HOST=your-redis-host.cloud.redislabs.com
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=your_redis_password_here

# ---- Qdrant Vector Store ----
QDRANT_HOST=localhost
QDRANT_PORT=6334
QDRANT_USE_TLS=false
QDRANT_API_KEY=

# ---- Chroma Vector Store ----
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=chatbot_documents

# ---- Chatbot API Security ----
# All /api/** endpoints require this key in the X-API-Key header.
CHATBOT_API_KEY=your-strong-api-key-here

# ---- Server ----
PORT=8080

# ---- Business Configuration ----
APP_MAX_TOKENS=1024
APP_DEFAULT_CONCEPT=lmg
APP_CACHE_TTL_HOURS=1
APP_CACHE_MAX_SIZE=1000
APP_RATE_LIMIT_RPM=60
APP_ANALYTICS_ENABLED=true
APP_CACHE_ENABLED=true
APP_VECTOR_SEARCH_ENABLED=true
